		sortByColumn: 'Risk Group Number'

		annotation SummarizationSetBy = Automatic

	partition 'Risk Groups' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "powerbi\data\fact_risk_groups.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"carrier", "risk_group", "flights", "late_flights", "predicted_late_flights", "model"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"carrier", type text}, {"risk_group", Int64.Type}, {"flights", Int64.Type}, {"late_flights", Int64.Type}, {"predicted_late_flights", type number}, {"model", type text}}, "en-US"),
				    Labeled = Table.AddColumn(Typed, "Risk Group", each if [risk_group] = 1 then "1 lowest" else if [risk_group] = 10 then "10 highest" else Text.From([risk_group]), type text)
				in
				    Labeled

	annotation PBI_ResultType = Table

