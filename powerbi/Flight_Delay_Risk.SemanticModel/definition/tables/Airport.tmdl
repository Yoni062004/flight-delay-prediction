	partition Airport = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "powerbi\data\dim_airport.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"airport", "airport_name", "airport_label", "city", "state", "latitude", "longitude", "size", "map_region"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"airport", type text}, {"airport_name", type text}, {"airport_label", type text}, {"city", type text}, {"state", type text}, {"latitude", type number}, {"longitude", type number}, {"size", type text}, {"map_region", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

