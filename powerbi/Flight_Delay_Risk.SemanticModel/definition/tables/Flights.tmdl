	partition Flights = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "powerbi\data\fact_flights_by_airport_hour.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"carrier", "origin", "departure_hour", "flights", "late_flights"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"carrier", type text}, {"origin", type text}, {"departure_hour", Int64.Type}, {"flights", Int64.Type}, {"late_flights", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

